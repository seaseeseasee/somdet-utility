# คัดลอกเป็น apps/api/.env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
NODE_ENV=development
PORT=3000
# บัญชีของแอป (ไม่ใช่ owner) — RLS มีผลกับบัญชีนี้
DATABASE_URL=postgres://mu_app:dev_app_password_change_me@localhost:5432/mu_utility
# บัญชี owner ใช้เฉพาะ migrate/seed
DATABASE_ADMIN_URL=postgres://mu_owner:dev_owner_password_change_me@localhost:5432/mu_utility
DB_APP_PASSWORD=dev_app_password_change_me
# dev = เข้าสู่ระบบจำลองสำหรับพัฒนา (ห้ามใช้ใน production) | oidc = Provider ID
AUTH_MODE=dev
SESSION_HOURS=8
COOKIE_SECURE=false
# ค่าต่อไปนี้รอเอกสารจากผู้ดูแลระบบ Provider ID (ดู docs ข้อ 2.6)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Chromium สำหรับสร้าง PDF (เว้นว่าง = ใช้ Chromium ของ Playwright)
PDF_CHROMIUM_PATH=
