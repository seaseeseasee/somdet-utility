# Backend (Fastify) + สคริปต์ migrate/seed — ใช้ image เดียวกัน
FROM node:22-alpine
# Chromium สำหรับสร้างรายงาน PDF (ฟอนต์ไทยฝังมากับรายงานแล้ว)
RUN apk add --no-cache chromium
ENV PDF_CHROMIUM_PATH=/usr/bin/chromium-browser
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/formula/package.json packages/formula/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci
COPY packages/formula packages/formula
COPY apps/api apps/api
RUN npm run build -w @mu/formula && npm run build -w @mu/api
WORKDIR /app/apps/api
ENV NODE_ENV=development HOST=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["node", "dist/server.js"]
